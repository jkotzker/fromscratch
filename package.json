{
  "name": "fromscratch",
  "productName": "FromScratch",
  "version": "2.2.0",
  "description": "simple autosaving scratchpad",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jkotzker/fromscratch/"
  },
  "author": {
    "name": "Kilian Valkhof",
    "email": "kilian@kilianvalkhof.com",
    "url": "https://kilianvalkhof.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jkotzker/fromscratch/issues"
  },
  "keywords": [
    "electron",
    "react",
    "scratchpad",
    "codemirror"
  ],
  "homepage": "https://github.com/jkotzker/fromscratch",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.9.1",
    "@codemirror/language": "^6.12.0",
    "@codemirror/search": "^6.6.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.2",
    "@eslint/js": "^9.39.0",
    "@vitejs/plugin-react": "^5.0.4",
    "compare-versions": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "minimist": "^1.2.8",
    "node-localstorage": "^3.0.5",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
